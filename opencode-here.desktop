[Desktop Entry]
Type=Service
MimeType=inode/directory;application/octet-stream;
Actions=opencodeHere;
X-KDE-MaxNumberOfUrls=1
X-KDE-Priority=TopLevel

[Desktop Action opencodeHere]
Name=Apri OpenCode qui
Name[en]=Open OpenCode Here
Icon=opencode-here
Exec=/home/zimu96/.local/bin/opencode-here %u
Comment=Apri opencode in un terminale, nella cartella dell'elemento scelto
