#!/bin/sh
#
# opencode-here-check  --  verifica (ed eventualmente ripara) la voce di menu
#                          "Apri OpenCode qui" in Dolphin.
#
#   opencode-here-check          solo verifica
#   opencode-here-check --fix    verifica e RIPARA quello che puo' rotto
#
# Pensato per dopo un aggiornamento di sistema (Dolphin, KIO, konsole, pacman)
# o dopo un aggiornamento di opencode.
# Esito: 0 = tutto a posto, 1 = qualcosa non va.

set -u

FIX=0
[ "${1:-}" = "--fix" ] && FIX=1

H="$HOME"
MENU="$H/.local/share/kio/servicemenus/opencode-here.desktop"
HERE="$H/.local/bin/opencode-here"
IN="$H/.local/bin/opencode-in"
ICONDIR="$H/.local/share/icons/hicolor"
KIOSK="$H/.config/kioslaverc"
RC="$H/.config/dolphinui.rc"
LOG="$H/.cache/opencode-here.log"
SHORTCUT_NAME="servicemenu_opencode-here.desktop::opencodeHere"

ok=0
ko=0
fixed=0

say() { printf '%s\n' "$*"; }
ok_() {
	ok=$((ok + 1))
	printf '  [ OK ] %s\n' "$1"
}
ko_() {
	ko=$((ko + 1))
	printf '  [KO  ] %s\n' "$1"
	printf '         -> %s\n' "$2"
}
repaired() {
	fixed=$((fixed + 1))
	printf '  [FIX] %s\n' "$1"
}

say ""
say "=== 1. Script di lancio ==="
for f in "$HERE" "$IN"; do
	if [ -f "$f" ] && [ -x "$f" ]; then
		ok_ "$(basename "$f") presente ed eseguibile"
	elif [ -f "$f" ]; then
		if [ "$FIX" -eq 1 ]; then
			chmod +x "$f" && repaired "reso eseguibile $f" && ok_ "$(basename "$f") eseguibile (riparato)"
		else
			ko_ "$(basename "$f") non e' eseguibile" "chmod +x $f  (oppure: opencode-here-check --fix)"
		fi
	else
		ko_ "$(basename "$f") MANCANTE" "file perso: reinstallarlo"
	fi
done

say ""
say "=== 2. Voce di menu (service menu KIO) ==="
if [ -f "$MENU" ]; then
	ok_ "opencode-here.desktop presente"

	# Il punto piu' fragile: KIO pretende che il file sia eseguibile,
	# altrimenti "Non sei autorizzato ad eseguire questo file".
	if [ -x "$MENU" ]; then
		ok_ "eseguibile (richiesto da KIO)"
	elif [ "$FIX" -eq 1 ]; then
		chmod +x "$MENU" && repaired "riapplicato chmod +x al .desktop" && ok_ "eseguibile (riparato)"
	else
		ko_ "NON eseguibile" "KIO lo blocchera': chmod +x $MENU  (oppure --fix)"
	fi

	grep -q '^Type=Service' "$MENU" 2>/dev/null
	[ $? -eq 0 ] && ok_ "Type=Service" || ko_ "manca Type=Service" "file .desktop corrotto"
	grep -q 'inode/directory' "$MENU" 2>/dev/null
	[ $? -eq 0 ] && ok_ "MimeType con inode/directory" || ko_ "manca inode/directory" "ricarica: non apparirebbe su cartelle/spazio vuoto"
	grep -q '^Exec=.*opencode-here' "$MENU" 2>/dev/null
	[ $? -eq 0 ] && ok_ "Exec punta a opencode-here" || ko_ "Exec mancante/corretto" "ricarica: non partirebbe"
else
	ko_ "opencode-here.desktop MANCANTE" "il file e' stato cancellato: ricrearlo"
fi

# KIO legge le voci da kio/servicemenus: se un aggiornamento cambiasse il
# percorso, la voce sparirebbe dal menu. Lo controlliamo sulle librerie.
KIOGUI=$(ls /usr/lib/libKF6KIOWidgets.so.6 2>/dev/null | head -1)
if [ -n "$KIOGUI" ]; then
	# Qt6 memorizza QStringLiteral in UTF-16: cerchiamo con -e l
	if strings -a -e l "$KIOGUI" 2>/dev/null | grep -q 'kio/servicemenus'; then
		ok_ "KIO cerca ancora in kio/servicemenus"
	else
		ko_ "KIO non cerca piu' in kio/servicemenus" "API KIO cambiata: la voce sparisce dal menu"
	fi
fi

say ""
say "=== 3. Icona ==="
if [ -f "$ICONDIR/scalable/apps/opencode-here.svg" ]; then
	ok_ "opencode-here.svg nel tema hicolor"
else
	ko_ "icona SVG mancante" "$ICONDIR/scalable/apps/opencode-here.svg"
fi
n=$(find "$ICONDIR" -name 'opencode-here.png' 2>/dev/null | wc -l)
if [ "$n" -gt 0 ]; then
	ok_ "PNG di fallback presenti ($n)"
else
	ko_ "PNG di fallback mancanti" "solo opzionale: si vede peggio ma funziona"
fi

say ""
say "=== 4. Autorizzazione KIO (kioslaverc) ==="
if [ -f "$KIOSK" ]; then
	ok_ "kioslaverc presente"
else
	ko_ "kioslaverc mancante" "crea $KIOSK con [KDE Action Restrictions] run_desktop_files=true"
fi
if kreadconfig6 --file kioslaverc --group "KDE Action Restrictions" --key run_desktop_files 2>/dev/null | grep -q true; then
	ok_ "run_desktop_files=true"
else
	ko_ "run_desktop_files non impostato" "verrà comunque consentito: il .desktop è eseguibile"
fi

say ""
say "=== 5. Scorciatoia (facoltativa) ==="
if [ -f "$RC" ] && grep -q "$SHORTCUT_NAME" "$RC" 2>/dev/null; then
	ok_ "Ctrl+Shift+O impostata in dolphinui.rc"
else
	say "  [--] assente: Dolphin la può rimuovere da solo, non è essenziale"
	say "        per rimetterla: dolphinui.rc con $SHORTCUT_NAME"
fi

say ""
say "=== 6. Programmi ==="
if command -v opencode >/dev/null 2>&1; then
	ok_ "opencode nel PATH: $(command -v opencode)"
elif [ -x /usr/bin/opencode ]; then
	ok_ "opencode in /usr/bin/opencode"
elif [ -x "$H/.opencode/bin/opencode" ]; then
	ok_ "opencode in ~/.opencode/bin/opencode"
else
	ko_ "opencode NON trovato" " reinstalla opencode, oppure OPENCODE_HERE_BIN=/percorso"
fi
if command -v opencode >/dev/null 2>&1; then
	say "         versione: $(opencode --version 2>/dev/null | head -1)"
	if opencode --help 2>&1 | grep -q '\[<directory>\]'; then
		ok_ "opencode accetta l'argomento <directory>"
	else
		say "  [--] non accetta più <directory>: lo script ricade sul cwd (funziona uguale)"
	fi
fi
found=""
for t in kde-terminal-exec xdg-terminal-exec konsole kgx alacritty xterm; do
	if command -v "$t" >/dev/null 2>&1; then
		found="$t"
		break
	fi
done
if [ -n "$found" ]; then
	ok_ "terminale disponibile: $found"
else
	ko_ "nessun terminale trovato" "installa konsole o kgx o xterm"
fi

clip=""
for t in wl-copy xclip; do
	if command -v "$t" >/dev/null 2>&1; then
		clip="$t"
		break
	fi
done
if [ -n "$clip" ] || qdbus6 org.kde.klipper >/dev/null 2>&1; then
	ok_ "clipboard disponibile: ${clip:-klipper su D-Bus} (usato solo come ripiego)"
else
	ko_ "nessun modo per copiare negli appunti" "installa wl-clipboard"
fi

say ""
say "=== 6b. Incolla automatico in opencode ==="
kreadconfig6 --file konsolerc --group KonsoleWindow --key EnableSecuritySensitiveDBusAPI 2>/dev/null | grep -q true
if [ $? -eq 0 ]; then
	ok_ "konsole: API D-Bus sensibile abilitata (serve per incollare)"
	# la'impostazione si legge all'avvio di konsole: se il konsole attivo e'
	# piu' vecchio del file di configurazione, la patch non e' ancora attiva
	if [ -f ~/.config/konsolerc ]; then
		konpids=$(pgrep -x konsole | tr '\n' ' ')
		for kp in $konpids; do
			start=$(stat -c %Y /proc/$kp 2>/dev/null || echo 0)
			cfg=$(stat -c %Y ~/.config/konsolerc 2>/dev/null || echo 0)
			if [ "$start" -gt 0 ] && [ "$start" -lt "$cfg" ]; then
				say "  [--] ATTENZIONE: konsole (pid $kp) e' partito PRIMA dell'impostazione"
				say "        chiudilo e riaprilo, altrimenti l'incolla automatico non funziona"
				say "        (il percorso va negli appunti: dentro opencode usa Ctrl+Shift+V)"
				break
			fi
		done
	fi
else
	ko_ "konsole: API D-Bus sensibile DISABILITATA" "in konsole: Impostazioni -> Generale -> 'Abilita le parti sensibili dell'API DBus'"
fi

say ""
say "=== 7. Diagnostica ==="
if [ -f "$LOG" ]; then
	say "  ultime invocazioni da $LOG:"
	tail -n 3 "$LOG" 2>/dev/null | while IFS= read -r l; do say "    $l"; done
else
	say "  (nessun log: non hai ancora usato la voce di menu)"
fi

say ""
say "---------------------------------------------"
say "OK: $ok   KO: $ko"
[ "$fixed" -gt 0 ] && say "Riparati: $fixed"
say ""
if [ "$ko" -eq 0 ]; then
	say "Tutto in ordine."
	exit 0
fi
say "Ci sono problemi: vedi le voci KO."
say "Se la voce è sparita dal menu, riavvia Dolphin (Ctrl+Q e riapri)."
exit 1
